+export function RemoteCursors(_props: Props) {
+  const presence = usePresence()
+
+  const promptPeers = createMemo(() =>
+    presence.peers().filter((p) => p.cursor?.area === "prompt"),
+  )
+
+  return (
+    <For each={promptPeers()}>
+      {(peer) => (
+        <div
